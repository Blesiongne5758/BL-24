# BL-24 Node.js backend environment template
# Copy to server/.env locally or enter values in the deployment platform.
# Never commit server/.env or any real secret.

PORT=5000
NODE_ENV=development
DEMO_MODE=false

# PostgreSQL/Supabase
# DATABASE_URL takes precedence over SUPABASE_DB_URL.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:REPLACE_WITH_DB_PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:REPLACE_WITH_DB_PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_CONNECTION_LIMIT=10
PGSSL=true
PGAPPNAME=bursalimbah-api

# JWT/session security
JWT_SECRET=[REDACTED]
[REDACTED]
JWT_REFRESH_EXPIRES_IN=7d

# Security and CORS
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5500
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Backup and retention
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# Current storage adapter: S3-compatible provider.
# Cloudinary adapter migration is a separate step; do not set this to cloudinary yet.
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY_ID=[REDACTED]
STORAGE_SECRET_ACCESS_KEY=[REDACTED]
STORAGE_PUBLIC_BUCKET=REPLACE_WITH_PUBLIC_BUCKET
STORAGE_PRIVATE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
STORAGE_CDN_DOMAIN=https://media.example.com
STORAGE_UPLOAD_TTL_SECONDS=900
STORAGE_GET_TTL_SECONDS=900

# Optional media optimizer configuration
MEDIA_OPTIMIZER_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=[REDACTED]
[REDACTED][REDACTED]

# Google OAuth is OFF by default in system_settings.
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID

# Supabase REST values are only needed if a later module calls Supabase APIs.
# Never put a service-role/secret key in frontend code.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
[REDACTED]REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=[REDACTED]
