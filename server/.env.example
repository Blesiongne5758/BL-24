# =======================================================
# BURSA LIMBAH BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin berkas ini ke .env lalu sesuaikan dengan lingkungan Anda
# =======================================================

# Port & Environment
PORT=5000
NODE_ENV=development

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=[REDACTED]
[REDACTED]
DB_CONNECTION_LIMIT=15

# Kunci Rahasia JWT & Session
JWT_SECRET=[REDACTED]
[REDACTED]
JWT_REFRESH_EXPIRES_IN=7d

# Keamanan & CORS
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Pengaturan Backup & Retensi
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# Mode Demo (set false di produksi agar backdoor password nonaktif)
DEMO_MODE=true

# =======================================================
# DECOUPLED CLOUD OBJECT STORAGE & MEDIA OPTIMIZATION (STRICT)
# Mendukung: AWS S3, DigitalOcean Spaces, MinIO, Cloudflare R2
# =======================================================
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY_ID=[REDACTED]
STORAGE_SECRET_ACCESS_KEY=[REDACTED]

# 2-Bucket Strategy: Public (Listing/Avatar) & Private (KYC Vault)
STORAGE_PUBLIC_BUCKET=circulink-public-media
STORAGE_PRIVATE_BUCKET=circulink-private-vault
STORAGE_CDN_DOMAIN=https://media.circulink.com
STORAGE_UPLOAD_TTL_SECONDS=900
STORAGE_GET_TTL_SECONDS=900

# Media Optimizer: 'imagekit' atau 'cloudinary'
MEDIA_OPTIMIZER_PROVIDER=imagekit
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/circulink
CLOUDINARY_CLOUD_NAME=circulink



# =======================================================
# CLOUDINARY MEDIA STORAGE & MULTIMEDIA OPTIMIZATION
# =======================================================
MEDIA_OPTIMIZER_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=v1pwadqp
CLOUDINARY_API_KEY=[REDACTED]
[REDACTED]your_cloudinary_api_secret_here
CLOUDINARY_URL=[REDACTED]


# =======================================================
# SUPABASE POSTGRESQL & REST API SERVICE
# =======================================================
SUPABASE_URL=https://vnajenbubmglwlsvteed.supabase.co
SUPABASE_ANON_KEY=[REDACTED]
SUPABASE_SERVICE_ROLE_KEY=[REDACTED]
[REDACTED][REDACTED]
