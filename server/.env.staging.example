# BL-24 Node.js backend - staging template
# Copy to server/.env only on a private machine.
# Never commit server/.env or replace placeholders with real secrets in Git.

NODE_ENV=production
PORT=5000
DEMO_MODE=false

# MySQL used by the Node.js backend
DB_HOST=mysql-staging.example.internal
DB_PORT=3306
DB_USER=bursalimbah_staging
DB_PASSWORD=[REDACTED]
[REDACTED]_staging
DB_CONNECTION_LIMIT=10

# JWT/session security
JWT_SECRET=[REDACTED]
[REDACTED]
JWT_REFRESH_EXPIRES_IN=7d

# Exact HTTPS origin(s) of the InfinityFree frontend, comma-separated
CORS_ORIGIN=https://your-site.example,https://www.your-site.example
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Backup paths; use persistent storage on a VPS or provider volume.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# Object storage for public/private uploads
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY_ID=[REDACTED]
STORAGE_SECRET_ACCESS_KEY=[REDACTED]
STORAGE_PUBLIC_BUCKET=REPLACE_WITH_PUBLIC_BUCKET
STORAGE_PRIVATE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
STORAGE_CDN_DOMAIN=https://media.example.com
STORAGE_UPLOAD_TTL_SECONDS=900
STORAGE_GET_TTL_SECONDS=900

# Optional media optimizer. Keep disabled/unconfigured until it is ready.
MEDIA_OPTIMIZER_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=[REDACTED]
[REDACTED][REDACTED]

# Google OAuth is disabled by default in system_settings.
# Configure this only when the staging Google client is ready.
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
