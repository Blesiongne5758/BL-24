Options -Indexes
<FilesMatch "^(config\.local\.php|\.env.*|.*\.(sql|log|bak))$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ router.php?path=$1 [QSA,L]
</IfModule>
